# Copier en .env (non versionné). Pas de secret en clair.

# Zones de données
SOLVEILLE_DATA_DIR=./data

# Bornage poli des ingestions (liste de départements à traiter ; vide = national progressif)
SOLVEILLE_DEPARTEMENTS=31,09,11,32,81,82  # ex. amorçage Occitanie pour QA, puis étendre

# Bases d'API (surchargables)
HUBEAU_BASE=https://hubeau.eaufrance.fr/api/v1
# meteo.data.gouv / data.gouv : résolution de la dernière ressource côté connecteur

# Politesse réseau
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=5
HTTP_PAUSE_S=0.2
