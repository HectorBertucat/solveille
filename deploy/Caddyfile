# Solveille — servi derrière Cloudflare Tunnel (modèle des autres apps de la VM).
# Caddy écoute :8083 ; route Cloudflare Tunnel (sur le tunnel « généraliste ») :
#   argile.hectorb.fr → http://localhost:8083  (public hostname ajouté côté dashboard)
# Importé par /etc/caddy/Caddyfile :  import /opt/solveille/deploy/Caddyfile
:8083 {
	encode zstd gzip

	# uvicorn (solveille-api.service) sert l'API + le front + les PMTiles sur 127.0.0.1:8001.
	reverse_proxy localhost:8001

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Note : l'en-tête noindex (garde-fou DVF) est posé par l'app FastAPI et traverse Caddy.

	# App shell (index.html + app.js) en `no-cache` : Cloudflare/le navigateur **revalident
	# via ETag** → un déploiement se propage immédiatement (sinon le défaut CDN de 4 h sert un
	# front périmé). Les PMTiles/données restent cacheables (long TTL).
	@appshell path / /index.html /app.js
	header @appshell Cache-Control "no-cache"
}
