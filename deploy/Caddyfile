# Solveille — servi derrière Cloudflare Tunnel (modèle des autres apps de la VM).
# Caddy écoute :8083 ; route Cloudflare Tunnel (sur le tunnel « généraliste ») :
#   argile.hectorb.fr → http://localhost:8083  (public hostname ajouté côté dashboard)
# Importé par /etc/caddy/Caddyfile :  import /opt/solveille/deploy/Caddyfile
:8083 {
	# Compression SAUF *.pmtiles : gzip casse les requêtes Range (→ 200 fichier entier au lieu de
	# 206) et corrompt la lecture des tuiles. Les glyphs .pbf, eux, sont des GET pleins → compressés.
	@notpmtiles not path *.pmtiles
	encode @notpmtiles zstd gzip

	# uvicorn (solveille-api.service) sert l'API + le front + les PMTiles sur 127.0.0.1:8001.
	reverse_proxy localhost:8001

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Note : l'en-tête noindex (garde-fou DVF) est posé par l'app FastAPI et traverse Caddy.

	# App shell (HTML + JS de l'app, dont le manifest de cache `assets.js`) en `no-cache` : Cloudflare/
	# le navigateur **revalident via ETag** → un déploiement se propage immédiatement (sinon le défaut
	# CDN de 4 h sert un front périmé). `assets.js` porte les nouveaux hashs ⇒ doit rester no-cache.
	@appshell path / /index.html /app.js /basemap-layers.js /deck3d.js /assets.js
	header @appshell Cache-Control "no-cache"

	# Données versionnées par hash de contenu (`?v=` côté front, B-perf) → IMMUTABLE long TTL : CF
	# cache au edge (avec une Cache Rule « eligible + clé incluant la query »), un rebuild change le
	# hash ⇒ cache-bust propre. Caddy matche le PATH (ignore `?v=`). Couvre les 2 PMTiles + 3D + index.
	@assets path *.pmtiles /tiles/communes-3d.* /communes-index.json
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Glyphs PBF du fond vectoriel : immuables (Noto Sans figés) → cache long, gain d'egress.
	@glyphs path /glyphs/*
	header @glyphs Cache-Control "public, max-age=2592000, immutable"
}
