[Unit]
Description=Solveille — rafraîchissement mensuel SWI (ingestion + mart + tuiles)
Documentation=https://github.com/hectorbertucat/solveille
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=SOLVEILLE_REPO=/opt/solveille
Environment=SOLVEILLE_DATA_DIR=/opt/solveille/data
WorkingDirectory=/opt/solveille
ExecStart=/opt/solveille/deploy/run-refresh.sh
Nice=10
# Politesse réseau : pas de retry agressif côté unit, le connecteur gère backoff + cache.
TimeoutStartSec=3600
