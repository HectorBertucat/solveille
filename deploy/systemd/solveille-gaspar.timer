[Unit]
Description=Solveille — déclencheur hebdomadaire GASPAR (les arrêtés Cat-Nat paraissent par vagues au JO)

[Timer]
# Tous les lundis à 04:30 (décalé du refresh SWI mensuel du 5 à 04:00 et du piézo quotidien à
# 05:30 ; de toute façon un flock partagé sérialise les refreshs qui touchent marts/tuiles).
OnCalendar=Mon *-*-* 04:30:00
# Rattrape un déclenchement manqué (VM éteinte) ; délai aléatoire pour lisser la charge réseau.
Persistent=true
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
